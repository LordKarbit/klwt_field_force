# Runtime
NODE_ENV=development
API_PORT=3005

# Browser/API origins used by Vite and Better Auth during development
AUTH_BASE_URL=http://127.0.0.1:3005
AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3010,http://localhost:3010
CORS_ORIGINS=http://127.0.0.1:3010,http://localhost:3010

# Required in production. Use a long random secret and never commit the real value.
BETTER_AUTH_SECRET=change-me-with-a-long-random-production-secret

# Optional Web Push configuration for production PWA push notifications.
# In development, local VAPID keys are generated under data/ and ignored by git.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@polibeli.local

# Demo seed switch. Development seeds demo users/data automatically.
SEED_DEMO_DATA=true
